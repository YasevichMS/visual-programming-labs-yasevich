    {
        "id": "b8f21450179ec584",
        "type": "function",
        "z": "2f1fe235e75989dd",
        "name": "Счётчик (flow context)",
        "func": "// Читаем текущее значение из flow context\nlet count = flow.get(\"counter\") || 0;\n\n// Увеличиваем\ncount = count + 1;\n\n// Сохраняем обратно в flow context\nflow.set(\"counter\", count);\n\n// Отправляем в debug\nmsg.payload = {\n    message: \"Счётчик увеличен\",\n    counter: count,\n    storedIn: \"flow context\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
